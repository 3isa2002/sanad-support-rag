# Ollama
OLLAMA_BASE_URL=http://localhost:11434
SANAD_CHAT_MODEL=qwen2.5:7b
SANAD_EMBED_MODEL=bge-m3

# Providers: "ollama" (default), "vllm" (OpenAI-compatible), or offline fallbacks ("hash" embedder, "fake" LLM)
SANAD_EMBEDDER=ollama
SANAD_LLM=ollama
SANAD_RAGAS_MODEL=qwen2.5:7b

# vLLM OpenAI-Compatible Serving (used when SANAD_LLM=vllm)
SANAD_VLLM_BASE_URL=http://localhost:8002/v1
SANAD_VLLM_MODEL=sanad-qwen25-ft
SANAD_VLLM_API_KEY=EMPTY

# Agent Tracing & MLOps: "jsonl" (default local spans), "langfuse", "langsmith", or "none"
SANAD_TRACING=jsonl
SANAD_TRACE_PATH=data/traces.jsonl
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sanad-support-rag

# Vector DB: "qdrant" (default) or legacy "numpy"
SANAD_VECTOR_BACKEND=qdrant
# Leave SANAD_QDRANT_URL empty to persist locally at <SANAD_INDEX_DIR>/qdrant,
# or point to a Qdrant server (e.g. http://localhost:6333 or http://qdrant:6333 in Docker).
SANAD_QDRANT_URL=
# SANAD_QDRANT_PATH=data/index/qdrant
SANAD_QDRANT_COLLECTION=sanad_kb

# LangGraph Multi-Agent Orchestration
SANAD_GROUNDING_RETRIES=1
SANAD_LLM_GROUNDING_CHECK=false

# Paths
SANAD_KB_DIR=data/kb
SANAD_INDEX_DIR=data/index
SANAD_DB_PATH=data/sanad.db

# Retrieval
SANAD_TOP_K=4
# Minimum cosine similarity of the best chunk before we hand off (tune with `sanad eval`).
# Leave unset for per-embedder defaults (ollama: 0.45, hash: 0.15).
# SANAD_MIN_SCORE=0.45

# Marketplace backend API (bundled mock: python -m mock_backend)
SANAD_BACKEND_URL=http://localhost:8001
SANAD_BACKEND_API_KEY=change-me
SANAD_BACKEND_TIMEOUT=5

# Sanad server
SANAD_HOST=127.0.0.1
SANAD_PORT=8000
# Protects /handoffs and /admin/reindex (send as X-Admin-Token). Empty = no auth (local dev only).
SANAD_ADMIN_TOKEN=change-me

# Mock backend (python -m mock_backend) — must match SANAD_BACKEND_API_KEY
MOCK_BACKEND_API_KEY=change-me
