# Ollama
OLLAMA_BASE_URL=http://localhost:11434
SANAD_CHAT_MODEL=qwen2.5:7b
SANAD_EMBED_MODEL=bge-m3

# Providers: "ollama" (default) or offline fallbacks ("hash" embedder, "fake" LLM)
SANAD_EMBEDDER=ollama
SANAD_LLM=ollama

# Paths
SANAD_KB_DIR=data/kb
SANAD_INDEX_DIR=data/index
SANAD_DB_PATH=data/sanad.db

# Retrieval
SANAD_TOP_K=4
# Minimum cosine similarity of the best chunk before we hand off (tune with `sanad eval`).
# Leave unset for per-embedder defaults (ollama: 0.45, hash: 0.25).
# SANAD_MIN_SCORE=0.45

# Marketplace backend API (bundled mock: python -m mock_backend)
SANAD_BACKEND_URL=http://localhost:8001
SANAD_BACKEND_API_KEY=change-me
SANAD_BACKEND_TIMEOUT=5

# Sanad server
SANAD_HOST=127.0.0.1
SANAD_PORT=8000
# Protects /handoffs and /admin/reindex (send as X-Admin-Token). Empty = no auth (local dev only).
SANAD_ADMIN_TOKEN=change-me

# Mock backend (python -m mock_backend) — must match SANAD_BACKEND_API_KEY
MOCK_BACKEND_API_KEY=change-me
